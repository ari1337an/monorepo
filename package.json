{
  "name": "Workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo template",
  "license": "MIT",
  "author": "Md Sahadul Hasan Arian",
  "packageManager": "pnpm@11.2.2",
  "//engines": "Pinned to Node 24 major — bump explicitly after validating against future majors",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:push": "pnpm --filter @workspace/database db:push",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:seed": "pnpm --filter @workspace/database db:seed",
    "db:studio": "pnpm --filter @workspace/database db:studio"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:"
  }
}
