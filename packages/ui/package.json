{
    "name": "@workspace/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "files": [
        "globals.css",
        "postcss.config.mjs",
        "lib",
        "components",
        "hooks"
    ],
    "exports": {
        "./globals.css": "./src/styles/globals.css",
        "./postcss.config": "./postcss.config.mjs",
        "./lib/*": "./src/lib/*.ts",
        "./components/*": "./src/components/*.tsx",
        "./hooks/*": "./src/hooks/*.ts"
    },
    "scripts": {
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "catalog:",
        "class-variance-authority": "catalog:",
        "clsx": "catalog:",
        "lucide-react": "catalog:",
        "tailwind-merge": "catalog:",
        "tw-animate-css": "catalog:"
    },
    "peerDependencies": {
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@workspace/config-eslint": "workspace:*",
        "@workspace/config-tailwind": "workspace:*",
        "@workspace/config-typescript": "workspace:*",
        "@tailwindcss/postcss": "catalog:",
        "@turbo/gen": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "eslint": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "shadcn": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:"
    }
}